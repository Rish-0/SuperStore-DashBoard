        <title>
          <formatted-text>
            <run>Total Deal Amount Ep. Number wise</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Shark Tank India' name='federated.1ucfew601pb5qy12cigpn1hto7c9' />
          </datasources>
          <datasource-dependencies datasource='federated.1ucfew601pb5qy12cigpn1hto7c9'>
            <column datatype='integer' name='[Episode Number]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Total Deal Amount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Total Deal Debt]' role='measure' type='quantitative' />
            <column-instance column='[Episode Number]' derivation='None' name='[none:Episode Number:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Total Deal Amount]' derivation='Sum' name='[sum:Total Deal Amount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total Deal Debt]' derivation='Sum' name='[sum:Total Deal Debt:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <text column='[federated.1ucfew601pb5qy12cigpn1hto7c9].[sum:Total Deal Debt:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-color' value='#f28e2b' />
                <format attr='mark-markers-mode' value='all' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.1ucfew601pb5qy12cigpn1hto7c9].[sum:Total Deal Amount:qk]</rows>
        <cols>[federated.1ucfew601pb5qy12cigpn1hto7c9].[none:Episode Number:ok]</cols>
      </table>
      <simple-id uuid='{DF4B6D5E-B3D4-4F49-80C2-B46165C66D75}' />
